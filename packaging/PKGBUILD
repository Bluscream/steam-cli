# Maintainer: Bluscream <https://github.com/Bluscream>
pkgname=steam-cli
pkgver=0.6.0
pkgrel=1
pkgdesc="Cross-platform Go CLI for the Steam Web API, Workshop, SteamCMD, ArchiSteamFarm and the desktop Steam client"
arch=('x86_64' 'aarch64')
url="https://github.com/Bluscream/steam-cli"
license=('Unlicense')
depends=('glibc')
makedepends=('go>=1.26')
optdepends=(
  'steam: for the "steamcli client" commands'
  'archisteamfarm: for the "steamcli asf" commands'
)
provides=('steamcli')
conflicts=('steamcli')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-mod=vendor -trimpath -buildmode=pie -modcacherw"
  go build -ldflags "-linkmode=external -X steamcli.local/steam/internal/cli.Version=$pkgver" \
    -o build/steamcli ./cmd/steamcli
}

check() {
  cd "$pkgname-$pkgver"
  go test -mod=vendor ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/steamcli "$pkgdir/usr/bin/steamcli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"

  # Shell completions, generated by the binary we just built.
  build/steamcli completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/steamcli"
  build/steamcli completion zsh  | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_steamcli"
  build/steamcli completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/steamcli.fish"
}
